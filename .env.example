# Copy to .env.local (web build) and .env.server (API, local dev). Never commit real values.

# --- web client, read at build time by Vite (public identifiers, not secrets) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- API server, read at runtime ---
# Must match the Firebase project that issues the ID tokens.
FIREBASE_PROJECT_ID=
PORT=3000
DB_PATH=./data/challenge.sqlite
# Folder containing the built web app (vite build output)
STATIC_DIR=./dist
# Time zone that decides what "today" is for week boundaries
CHALLENGE_TZ=Australia/Brisbane
